@using BedarfsCheck.Controllers
@{
    MainController controller = ViewContext.RouteData.Values["controller"] as MainController;
    Dictionary<string, MainController.Item> items = Model[1] as Dictionary<string, MainController.Item>;
    MainController.Group group = Model[0] as MainController.Group;
}

@functions
{

    string AddImage(MainController.Item item)
    {
        //return $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic_action/{item.Name}.png")}\"/>";
        return $"<div class=\"imgContainer\">"+Environment.NewLine+
            $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic/button.png")}\"/>"+Environment.NewLine+
            $"<img class=\"imgOverlay\" src=\"{@Url.Content($"~/pic_action/{item.Name}.png")}\"/>"+Environment.NewLine+
               $"</div>"+Environment.NewLine;
    }
}

@foreach (MainController.Item item in items.Values.Where(_=>_.Group==group))
{
    <table style="display: inline-table">
        <tr><td width="100px" >@Html.Raw(AddImage(item))</td></tr>
        <tr><td>@item.Description</td></tr>
    </table>
}