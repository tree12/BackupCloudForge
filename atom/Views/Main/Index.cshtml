@using System.Security.AccessControl
@using BedarfsCheck.Controllers
@using Microsoft.AspNetCore.Routing

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
    @ViewContext.RouteData.Values["controller"]
*@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    MainController controller = ViewContext.RouteData.Values["controller"] as MainController;
    Dictionary<string, MainController.Item> items = Model as Dictionary<string,MainController.Item>;
    List<MainController.Group> groups = items.Values.Select(_ => _.Group).Distinct().ToList();
}

@functions
{

    string AddImageForPreload(MainController.Item item )
    {
        return $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic_action/{item.Name}.png")}\"/>"+
               $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic_action/{item.Name}_check.png")}\"/>"+
               $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic_action/{item.Name}_over.png")}\"/>"+
               $"<img class=\"switchImg {item.Group.Name}\" id=\"{item.Name}\" src=\"{@Url.Content($"~/pic_action/{item.Name}_check_over.png")}\"/>";
    }            
}
 
<!DOCTYPE html>
<html>
<head>
    <style type="text/css">

        .imgContainer {
            position:relative;
        }

        .switchImg {
            width: 100px;
            height: 100px;
        }

        .imgOverlay {
            position: absolute;
            left: 15px;
            top: 15px;
            width: 70px;
            height: 70px;
            pointer-events: none;
        }


        div .error {
            border: solid red 2x;
            background-color: lightcoral;
            font-size: larger;
            text-align: center;
            width: 100%;
            padding: 50px

        }

        .group_table {
            border-collapse: separate;
            border: solid #ffe9c5 2px;
            border-radius: 6px;
            -moz-border-radius: 6px;
        }

        /*
        table .result_table {
            border-collapse: separate;
            border: solid black 2px;
            border-radius: 6px;
            -moz-border-radius: 6px;
        }

        table .result_table_over {
            border-collapse: separate;
            border: solid yellowgreen 4px;
            border-radius: 6px;
            background-color: lightgreen;
            -moz-border-radius: 6px;
        }


        th .result_table {
            border-bottom: solid darkgreen 2px;
        }*/


        .modal {
            display:    none;
            position:   fixed;
            z-index:    1000;
            top:        0;
            left:       0;
            height:     100%;
            width:      100%;
            background: rgba( 255, 255, 255, .8 )
                        url(@Url.Content("~/pic/loading.gif"))
                        50% 50%
                        no-repeat;
        }

        /* When the body has the loading class, we turn
   the scrollbar off with overflow:hidden */
        body.loading {
            overflow: hidden;
        }

        /* Anytime the body has the loading class, our
   modal element will be visible */
        body.loading .modal {
            display: block;
        }

    </style>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script>
        
        var items = @Html.Raw(Json.Serialize(items));
        $(document).ready(function() {
            $("button").click(function () {
                $("body").addClass("loading"); 
                var data = JSON.stringify(items);
                $.ajax({
                    url: "@Url.Action("Calculate")", // /Home/ReferralsList'
                    type: "POST",
                    contentType: "application/json",
                    //dataType: "json",
                    data: data,
                    success: function(partial) {
                        $('#result').html(partial);
                        $("body").removeClass("loading"); 
                    }
                });
            });
            $(".switchImg").click(function(ev) {
                //alert('icon clicked');
                SwitchImage(ev.target.id, true, true);
            });

            $(".switchImg").mouseenter(function(ev) {
                SwitchImage(ev.target.id, false, true);
            }).mouseleave(function(ev) {
                SwitchImage(ev.target.id, false, false);
            });
            /*$(".test" ).mouseover(function() {
                SwitchImage(event.target.id,false,true)
            }).mouseout(function() {
                SwitchImage(event.target.id,false,false)
            });*/

            $(".switchImg").on('dragstart', function(event) { event.preventDefault(); });
        });

        function SwitchImage(id, change, over) {
            if (change) items[id].selected = !items[id].selected;
            //var imgName = id;
            var imgName = "button";
            if (items[id].selected) imgName += "_check";
            if (over) imgName += "_over";
            $("#" + id).attr("src", @Url.Content("~/pic/") + imgName + ".png");
            /*if (!items[id].group.multiselection) {
                alert("multino");
            }*/
            if (!items[id].group.multiselection && items[id].selected && change) {
                $("." + items[id].group.name).each(function(index, elem) {
                    if (elem.id != id) {
                        items[elem.id].selected = false;
                        $("#" + elem.id).attr("src", @Url.Content("~/pic/") + "button.png");
                    }
                });
            }
        }


    </script>
</head>
<body unselectable="on" onselectstart="return false;">


@foreach (MainController.Group group in groups)
    {
    <div style="width: 100%; align-content: center; display: flex;justify-content: center; margin-bottom: 40px">
        <table  style="margin: 0 auto; display: inline-table;">
            <thead  style="text-align: center; font-size: large ; overflow: hidden"  ><tr ><th style="font-size: larger;color: #ffb640" >@group.Description</th></tr></thead>
            <tr class="group_table">                
                <td class="group_table" style="align-content: space-around" align="center">
                    @Html.Partial("GroupView", new object[] {group, items})
                </td >
            </tr>
    </table>   
    </div>
}
    
<div align="center" style="align-content: center;margin-bottom: 50px">
<button style="background-color: lightgreen; font-size: x-large; border: solid green 2px; padding: 10px; border-radius: 6px">Anfrage auswerten</button>
</div>

<div id="result"></div>
    
<div class="modal"><!-- Place at bottom of page --></div>
<div id="preload" style="display: none">
    *{ @foreach (var item in items.Values)
       {
           @Html.Raw(AddImageForPreload(item));
       }}
    
    <img src="@Url.Content($"~/pic/button.png")"/>
    <img src="@Url.Content($"~/pic/button_check.png")" />
    <img src="@Url.Content($"~/pic/button_over.png")" />
    <img src="@Url.Content($"~/pic/button_check_over.png")" />
    <img src="@Url.Content($"~/pic/loading.png")" />
</div>
<div style="height: 100%; width: 100%; align-content: last-baseline; text-align: right;align-content: right"  align="right">
<a href="https://icons8.com/icon/26075/Traveler-Filled">Traveler filled icon credits</a> 
</div>
</body>
</html>