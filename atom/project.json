{
  "version": "1.0.0-*",
  "dependencies": {
    "Microsoft.AspNetCore.Server.Kestrel": "1.1.0-*",
    "Microsoft.Extensions.Logging.Console": "1.1.0-*",
    "Microsoft.AspNetCore.StaticFiles": "1.1.0-*"
  },
  "buildOptions": {
    "emitEntryPoint": true
  },
  "frameworks": {
    "netcoreapp1.1": {    
      "dependencies": {
        "Microsoft.AspNetCore": {
          "target": "Package",
          "version": "1.1.2"
        },
        "Microsoft.Extensions.Logging.Debug": {
          "target": "Package",
          "version": "1.1.2"
        },
        "Microsoft.NETCore.App": {
          "target": "Package",
          "version": "1.1.2",
          "autoReferenced": true
        },
        "Microsoft.AspNetCore.Mvc": {
          "target": "Package",
          "version": "1.1.3"
        },
        "Microsoft.ApplicationInsights.AspNetCore": {
          "target": "Package",
          "version": "2.0.0"
        }
      }
    }
  },
  "publishOptions": {
    "include": [
      "wwwroot",
      "hosting.json",
      "testCert.pfx"
    ]
  }
}