                   <Label text="Full Name" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                   <TextField fx:id="txtFullName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                   <Label text="Roles" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                   <ListView fx:id="lstRoles" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </center>
         <top>
            <Label fx:id="lblHeader" alignment="CENTER" text="Add User" BorderPane.alignment="CENTER">
               <font>
                  <Font size="22.0" />
               </font>
               <opaqueInsets>
