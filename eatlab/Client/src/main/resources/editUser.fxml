<AnchorPane fx:id="mainPanel" prefHeight="382.0" prefWidth="644.0" xmlns="http://javafx.com/javafx/8.0.121" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eatlab.dms.client.EditUserController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="730.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <bottom>
            <AnchorPane prefHeight="15.0" prefWidth="996.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" BorderPane.alignment="CENTER">
                <Button text="Cancel" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" onAction="#handleCancel" />
                <Button fx:id="btnSave" text="Add User" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" onAction="#handleSave" />
               <BorderPane.margin>
                  <Insets top="30.0" />
               </BorderPane.margin>
            </AnchorPane>
         </bottom>
         <center>
            
         </center>
         <center>
            <GridPane hgap="20.0" vgap="10.0" BorderPane.alignment="CENTER">
              <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="SOMETIMES" />
                <RowConstraints vgrow="SOMETIMES" />
                <RowConstraints vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <Label text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0" />
