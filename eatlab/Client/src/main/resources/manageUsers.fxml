<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane fx:id="mainPane" prefHeight="382.0" prefWidth="765.0" xmlns="http://javafx.com/javafx/8.0.121" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eatlab.dms.client.ManageUserController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="730.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <top>
            <AnchorPane prefHeight="71.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" BorderPane.alignment="CENTER">
               <ToolBar layoutY="-6.0" prefHeight="40.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                 <items>
                     <Button onAction="#handleAddUser" text="Add User">
                        <graphic>
                           <FontAwesomeIconView styleClass="FontAwsome" glyphName="USER_PLUS" size="20px" textAlignment="RIGHT" />
                        </graphic>
                     </Button>
                 </items>
               </ToolBar>
               <BorderPane.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </BorderPane.margin>
            </AnchorPane>
         </top>
         <bottom>
            <Pane prefHeight="15.0" prefWidth="996.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" BorderPane.alignment="CENTER" />
         </bottom>
         <center>
            <TableView fx:id="tableView" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" BorderPane.alignment="CENTER">
              <columns>
                 <TableColumn prefWidth="93.0" text="Id"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                <TableColumn prefWidth="103.0" text="Username"><cellValueFactory><PropertyValueFactory property="userName" /></cellValueFactory></TableColumn>
                 <TableColumn prefWidth="142.0" text="full Name"><cellValueFactory><PropertyValueFactory property="fullName" /></cellValueFactory></TableColumn>
                 <TableColumn prefWidth="235.0" text="Roles"><cellValueFactory><PropertyValueFactory property="permissions" /></cellValueFactory></TableColumn>
                 <TableColumn fx:id="btnOpen" prefWidth="187.0" text="Action" />
              </columns>
            </TableView>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
